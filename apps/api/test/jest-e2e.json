{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)sx?$": ["ts-jest", { "useESM": true }]
  },
  "transformIgnorePatterns": [
    "node_modules/(?!(@nestjs/cache-manager|cache-manager|@nestjs/common)/)"
  ]
}
