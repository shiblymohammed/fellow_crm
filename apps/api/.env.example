# Database
DATABASE_URL="postgresql://fellow:fellow123@localhost:5432/fellow_crm"

# Security - JWT Configuration (REQUIRED - No defaults for security)
# CRITICAL: Generate strong secrets for production
# Use: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="your-super-secret-jwt-key-CHANGE-THIS-IN-PRODUCTION"
JWT_REFRESH_SECRET="your-super-secret-refresh-key-CHANGE-THIS-IN-PRODUCTION"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Server Configuration
PORT=3001
NODE_ENV=development
WEB_URL="http://localhost:3002"

# Storage Configuration
# Options: 'local' or 's3'
STORAGE_TYPE=local

# AWS S3 Configuration (only needed if STORAGE_TYPE=s3)
# SECURITY NOTE: Files are stored with 'private' ACL - use presigned URLs for access
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_S3_BUCKET=fellow-crm-uploads
# AWS_REGION=us-east-1
